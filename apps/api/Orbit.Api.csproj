<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- Test doubles of the web app: fakes, fixed clocks and ids, sample data. They live next to the code
       they stand in for, but only specs use them. -->
  <ItemGroup>
    <WebTestDoubles Include="..\web\src\**\fake-*.ts;..\web\src\**\fixed-clock.ts;..\web\src\**\sequential-id-generator.ts;..\web\src\**\sample-routines.ts;..\web\src\**\*.testing.ts" />
  </ItemGroup>

  <!-- The SonarScanner for .NET derives the analysis scope from MSBuild items,
       so the Angular sources must be linked here to be analyzed by SonarCloud.
       Spec files and the test doubles they share are linked by the test project instead, so they are
       analyzed as test code. -->
  <ItemGroup>
    <None Include="..\web\src\**\*.ts" Exclude="..\web\src\**\*.spec.ts;@(WebTestDoubles)" />
    <None Include="..\web\src\**\*.html" />
    <None Include="..\web\src\**\*.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
