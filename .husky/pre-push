#!/bin/sh

protected_branch="main"
current_branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$current_branch" = "$protected_branch" ]; then
  exit 0
fi

# Checks only: the pushed commits are what CI will see. Rewriting the last commit here (an amend with
# --no-verify) used to fold any uncommitted work into it behind the developer's back.
echo "[pre-push] Checking .NET formatting..."
dotnet format Budgeter.slnx --no-restore --verify-no-changes || {
  echo "[pre-push] Run 'dotnet format Budgeter.slnx' and commit the result."
  exit 1
}

echo "[pre-push] Checking web formatting and lint..."
(cd apps/web && npm run format:check) || {
  echo "[pre-push] Run 'npm run format' in apps/web and commit the result."
  exit 1
}
(cd apps/web && npm run lint) || exit 1

if command -v gh >/dev/null 2>&1; then
  if ! gh pr view "$current_branch" >/dev/null 2>&1; then
    echo "[pre-push] Opening pull request for $current_branch..."
    gh pr create --fill --base main --head "$current_branch" || true
  fi
fi
